{
  "ci": {
    "collect": {
      "staticDistDir": "./.site",
      "url": ["/index.html", "/loyihalar/index.html", "/loyihalar/socialauto/index.html", "/xizmatlar/crm-erp/index.html", "/blog/ai-avval-backend/index.html", "/taklif/index.html"],
      "numberOfRuns": 2,
      "settings": { "formFactor": "mobile", "throttlingMethod": "simulate" }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ":[0-9]+/index\\.html$",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.9 }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 2000 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 1 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }]
          }
        },
        {
          "matchingUrlPattern": "/[a-z-]+/.*index\\.html$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 1 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
            "total-blocking-time": ["warn", { "maxNumericValue": 200 }]
          }
        }
      ]
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
