# Copy to .env (local) or /opt/jamolxon/<env>/.env (server, chmod 600). Never commit real values.
# Generate secrets: python -c "import secrets;print(secrets.token_urlsafe(48))"
# ENCRYPTION_KEY:   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"

ENV=local                       # local | staging | production
SITE_URL=http://localhost:8080
ADMIN_URL=http://localhost:5173
COOKIE_SECURE=false             # true on staging/production
CORS_ORIGINS='["http://localhost:5173","http://localhost:8080"]'

DATABASE_URL=postgresql+asyncpg://jamolxon:jamolxon@127.0.0.1:5432/jamolxon
REDIS_URL=redis://:devredis@127.0.0.1:6380/0

SECRET_KEY=
JWT_KEY=
ENCRYPTION_KEY=
IP_HASH_SALT=

# Cloudflare Turnstile (empty = disabled; other spam signals still apply)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Telegram bot for lead notifications and alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# SMTP (email fallback + client confirmation). SPF/DKIM/DMARC must be set for the sender domain.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Jamolxon <noreply@jamolxon.uz>"
OWNER_EMAIL=

# Cloudflare R2 (empty = local disk under MEDIA_DIR, served at /media/)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
MEDIA_PUBLIC_URL=/media
MEDIA_DIR=var/media

# Cloudflare cache purge after rebuild (optional)
CF_ZONE_ID=
CF_API_TOKEN=

SITE_OUT_DIR=var/site
FRONTEND_DIST=

SENTRY_DSN=
HEARTBEAT_URL=
