# jamolxon.uz site blocks. Imported by infra/caddy/Caddyfile on the dedicated server (jamolxon-caddy);
# on the old shared server they were pasted into /home/socialauto/Caddyfile.
# Reload: docker exec jamolxon-caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile

jamolxon.uz, admin.jamolxon.uz {
	encode zstd gzip
	reverse_proxy jamolxon-nginx:80 {
		header_up X-Forwarded-For {client_ip}
	}
}

www.jamolxon.uz {
	redir https://jamolxon.uz{uri} 301
}

staging.jamolxon.uz, admin.staging.jamolxon.uz {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy jamolxon-staging-nginx:80 {
		header_up X-Forwarded-For {client_ip}
	}
}
